-- Local cache of everything fetched from platforms. Independent of any profile.
-- All ids are platform-qualified (`youtube:…`); timestamps are epoch seconds.

CREATE TABLE video (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    tags TEXT NOT NULL,              -- JSON array of strings
    duration_seconds INTEGER,
    channel_id TEXT,
    channel_name TEXT,
    language TEXT,
    thumbnail_url TEXT,
    uploaded_at INTEGER,
    is_short INTEGER AS kotlin.Boolean NOT NULL,
    extra TEXT NOT NULL,             -- JSON object of platform-specific strings
    fetched_at INTEGER NOT NULL
);

-- Related videos as listed by the platform when `video_id` was fetched.
CREATE TABLE related_video (
    video_id TEXT NOT NULL REFERENCES video(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    related_id TEXT NOT NULL,
    title TEXT NOT NULL,
    channel_id TEXT,
    channel_name TEXT,
    duration_seconds INTEGER,
    is_short INTEGER AS kotlin.Boolean NOT NULL,
    uploaded_at INTEGER,
    PRIMARY KEY (video_id, position)
);

-- Videos the platform says are gone, so they aren't requested again.
CREATE TABLE unavailable_video (
    id TEXT NOT NULL PRIMARY KEY,
    reason TEXT NOT NULL,
    checked_at INTEGER NOT NULL
);

selectVideo:
SELECT * FROM video WHERE id = ?;

upsertVideo:
INSERT OR REPLACE INTO video VALUES ?;

countVideos:
SELECT count(*) FROM video;

selectRelated:
SELECT * FROM related_video WHERE video_id = ? ORDER BY position;

deleteRelated:
DELETE FROM related_video WHERE video_id = ?;

insertRelated:
INSERT INTO related_video VALUES ?;

selectUnavailable:
SELECT reason FROM unavailable_video WHERE id = ?;

upsertUnavailable:
INSERT OR REPLACE INTO unavailable_video VALUES (?, ?, ?);

deleteUnavailable:
DELETE FROM unavailable_video WHERE id = ?;

selectAllVideos:
SELECT * FROM video;

selectVideoIds:
SELECT id FROM video ORDER BY id;

-- Search results per query (SPEC: candidates are cached for a day).
CREATE TABLE search_cache (
    platform TEXT NOT NULL,
    query TEXT NOT NULL,
    results TEXT NOT NULL,           -- JSON list of video stubs
    fetched_at INTEGER NOT NULL,
    PRIMARY KEY (platform, query)
);

selectSearch:
SELECT results, fetched_at FROM search_cache WHERE platform = ? AND query = ?;

upsertSearch:
INSERT OR REPLACE INTO search_cache VALUES (?, ?, ?, ?);
